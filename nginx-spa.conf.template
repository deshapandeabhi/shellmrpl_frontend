# Nginx config for React SPA (Single Page Application)
# Serves built files and redirects all routes to index.html for client-side routing

server {
    listen ${PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression for performance
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;

    # Modern Document API Fallback
    # Maps /api/v1/documents/ANY_SUBDIR/filename.ext -> /api/v1/documents/filename.ext
    # This solves 404s when React uses virtual subdirectories for organization
    location ~* ^/api/v1/documents/.*\.(pdf|docx|png)$ {
        root /usr/share/nginx/html;
        # Extract filename and try root documents folder as fallback
        rewrite ^.*/([^/]+\.(pdf|docx|png))$ /api/v1/documents/$1 break;
        try_files $uri /api/v1/documents/$1 =404;
    }

    # Static files with caching
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|pdf|docx|doc|xls|xlsx|zip)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # API Proxy — Pointing to the backend service
    # In Railway, use the internal service name (e.g., backend:8080)
    location /api {
        resolver 127.0.0.11 valid=30s;
        set $backend_url http://${BACKEND_HOST}:8080;
        proxy_pass $backend_url;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # All other routes → index.html (React Router handles client-side routing)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security: hide Nginx version
    server_tokens off;
}
